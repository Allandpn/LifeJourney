# Copie este arquivo para .env (na raiz do repositório) e ajuste. O .env real nunca vai para o git.

# ---------- no seu computador (desenvolvimento) ----------

# "desenvolvimento" (padrão) ou "producao". No Raspberry Pi o docker-compose.yml força "producao".
# Em produção: o cookie de sessão só anda por HTTPS, a documentação da API some,
# e o servidor não liga se a conta de desenvolvimento ainda tiver a senha conhecida.
LJ_MODO=desenvolvimento

# Arquivo do banco e pasta das fotos. Padrão: dentro de dados-pessoais/ (fora do git).
# LJ_BANCO=dados-pessoais/lifejourney.db
# LJ_FOTOS=dados-pessoais/fotos

# E-mail da conta de desenvolvimento, criada por "python -m app.exemplo".
# LJ_EMAIL_DESENVOLVIMENTO=dev@exemplo.local

# ---------- no Raspberry Pi (docs/09-publicacao.md) ----------

# Acesso pelo Tailscale (sem domínio): um nó Tailscale só do projeto.
# COMPOSE_PROFILES=tailscale
# TS_HOSTNAME=vida-em-semanas
# TS_AUTHKEY=tskey-auth-...
# TS_EXTRA_ARGS=--advertise-tags=tag:semanas
# LJ_ORIGENS_PERMITIDAS=vida-em-semanas.sua-tailnet.ts.net

# Acesso pela Cloudflare (com domínio): liga o perfil do túnel.
# COMPOSE_PROFILES=cloudflare

# Token do túnel, copiado do painel da Cloudflare (Zero Trust > Networks > Tunnels).
# CLOUDFLARE_TUNNEL_TOKEN=

# Chave PÚBLICA do age (começa com age1...). A chave privada NÃO vai para o Pi.
# LJ_COPIA_CHAVE_PUBLICA=

# Quantas cópias de segurança manter (as mais antigas são apagadas).
# LJ_COPIA_MANTER=30

# Pastas no Pi para os dados e as cópias (de preferência no SSD cifrado e em outro disco).
# LJ_PASTA_DADOS=/mnt/dados/vida-em-semanas
# LJ_PASTA_COPIAS=/mnt/copias/vida-em-semanas
